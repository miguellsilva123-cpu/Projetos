 "phrases": [
  {
   "id": "b01",
   "text": "Ela sempre fala: bora marcar sim! Mas nunca marca. Insisto ou desisto?",
   "old": 0.4,
   "start": 0.25
  },
  {
   "id": "b02",
   "text": "Nenhum dos dois.",
   "old": 4.2,
   "start": 4.27
  },
  {
   "id": "b02",
   "text": "Para de repetir o convite, e muda o convite.",
   "old": 5.2,
   "start": 5.19
  },
  {
   "id": "b02",
   "text": "Do jeito que tá, não sai nunca.",
   "old": 7.3,
   "start": 7.73
  },
  {
   "id": "b03",
   "text": "Agora olha do lado dela.",
   "old": 9.0,
   "start": 9.992
  },
  {
   "id": "b03",
   "text": "Essa semana, três caras diferentes já mandaram bora marcar.",
   "old": 10.6,
   "start": 11.452
  },
  {
   "id": "b03",
   "text": "A gente tem que se ver. Bora tomar algo qualquer dia.",
   "old": 13.4,
   "start": 14.832
  },
  {
   "id": "b03",
   "text": "É tudo igual.",
   "old": 16.0,
   "start": 18.222
  },
  {
   "id": "b04",
   "text": "Pensa: o que no seu convite faria ela lembrar de você,",
   "old": 17.6,
   "start": 19.299
  },
  {
   "id": "b04",
   "text": "e não dos outros dois?",
   "old": 19.7,
   "start": 22.209
  },
  {
   "id": "b05",
   "text": "Bora marcar algum dia não é convite.",
   "old": 22.4,
   "start": 24.234
  },
  {
   "id": "b05",
   "text": "É uma ideia solta. E ideia solta, ninguém precisa recusar.",
   "old": 23.9,
   "start": 25.934
  },
  {
   "id": "b05",
   "text": "Não tem dia. Não tem lugar. Não tem plano.",
   "old": 26.6,
   "start": 29.734
  },
  {
   "id": "b06",
   "text": "Você joga a ideia, e espera que ela monte o encontro sozinha.",
   "old": 29.6,
   "start": 32.593
  },
  {
   "id": "b06",
   "text": "E montar a sua agenda não é tarefa dela.",
   "old": 32.6,
   "start": 36.303
  },
  {
   "id": "b07",
   "text": "E fica claro pra ela:",
   "old": 35.0,
   "start": 38.788
  },
  {
   "id": "b07",
   "text": "esse convite serviria pra qualquer uma.",
   "old": 36.0,
   "start": 40.258
  },
  {
   "id": "b08",
   "text": "Só que repara: ela sai, sim.",
   "old": 39.2,
   "start": 43.165
  },
  {
   "id": "b08",
   "text": "Só não sai com convite vago.",
   "old": 40.6,
   "start": 44.705
  },
  {
   "id": "b08",
   "text": "Ela topa quando o convite chega pronto:",
   "old": 42.0,
   "start": 46.485
  },
  {
   "id": "b08",
   "text": "um motivo, um lugar e um dia.",
   "old": 44.0,
   "start": 48.085
  },
  {
   "id": "b09",
   "text": "Você falou que ama café coado.",
   "old": 47.0,
   "start": 50.538
  },
  {
   "id": "b09",
   "text": "Tem um lugar perto do seu trampo que é absurdo.",
   "old": 48.6,
   "start": 52.518
  },
  {
   "id": "b09",
   "text": "Quinta, sete da noite?",
   "old": 50.8,
   "start": 54.998
  },
  {
   "id": "b09",
   "text": "E se não der, me fala um dia bom pra você.",
   "old": 52.2,
   "start": 56.088
  },
  {
   "id": "b10",
   "text": "Uma mensagem dessas resolve o que três meses de bora marcar não resolveram.",
   "old": 55.0,
   "start": 59.064
  },
  {
   "id": "b11",
   "text": "Se ela topa ou sugere outro dia: tem interesse.",
   "old": 58.4,
   "start": 64.404
  },
  {
   "id": "b11",
   "text": "Se ela foge de um convite concreto e não propõe nada: essa é a resposta.",
   "old": 61.0,
   "start": 67.284
  },
  {
   "id": "b11",
   "text": "Aí você não insiste, nem some com raiva. Só segue.",
   "old": 64.6,
   "start": 71.174
  },
  {
   "id": "b12",
   "text": "E tem mais: convite bom não salva uma vida sem graça.",
   "old": 68.2,
   "start": 75.021
  },
  {
   "id": "b12",
   "text": "Os lugares que você conhece, o que você faz no fim de semana, a conversa que você tem.",
   "old": 71.0,
   "start": 78.521
  },
  {
   "id": "b13",
   "text": "Cuida disso, e chamar pra sair vira detalhe.",
   "old": 75.6,
   "start": 83.623
  },
  {
   "id": "b13",
   "text": "Tenha uma vida que dá vontade de dividir,",
   "old": 77.8,
   "start": 86.463
  },
  {
   "id": "b13",
   "text": "e chama ela pra viver um pedaço disso com você.",
   "old": 79.6,
   "start": 88.743
  },
  {
   "id": "b14",
   "text": "Manda a sua pergunta nos comentários, que eu respondo no próximo vídeo.",
   "old": 82.0,
   "start": 91.925
  }
 ],
