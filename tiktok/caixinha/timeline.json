 "phrases": [
  {
   "id": "b01",
   "text": "Ela sempre fala: bora marcar! Mas nunca marca. Insisto ou desisto?",
   "old": 0.4,
   "start": 0.6
  },
  {
   "id": "b02",
   "text": "Para de insistir, cara.",
   "old": 4.2,
   "start": 4.72
  },
  {
   "id": "b02",
   "text": "E aproveita e para de convidar desse jeito.",
   "old": 5.4,
   "start": 5.59
  },
  {
   "id": "b02",
   "text": "Porque assim, não vai sair nunca.",
   "old": 7.2,
   "start": 7.99
  },
  {
   "id": "b03",
   "text": "Deixa eu te mostrar o outro lado da tela.",
   "old": 9.0,
   "start": 10.503
  },
  {
   "id": "b03",
   "text": "Essa semana ela ouviu bora marcar de três caras diferentes.",
   "old": 10.8,
   "start": 12.843
  },
  {
   "id": "b03",
   "text": "A gente tem que se ver. Bora tomar algo qualquer dia.",
   "old": 13.4,
   "start": 16.273
  },
  {
   "id": "b03",
   "text": "É tudo igual.",
   "old": 16.0,
   "start": 19.683
  },
  {
   "id": "b04",
   "text": "Pensa comigo: por que ela sairia com você, se o seu convite é igualzinho ao de todo mundo?",
   "old": 17.6,
   "start": 20.785
  },
  {
   "id": "b05",
   "text": "Bora marcar algum dia é convite de quem não pensou nem dez segundos.",
   "old": 22.4,
   "start": 26.365
  },
  {
   "id": "b05",
   "text": "Não tem dia. Não tem lugar. Não tem plano.",
   "old": 25.2,
   "start": 30.365
  },
  {
   "id": "b06",
   "text": "É você querendo que ela organize um encontro que nem você organizou.",
   "old": 28.4,
   "start": 33.324
  },
  {
   "id": "b06",
   "text": "E ela não tem obrigação nenhuma de transformar o seu algum dia numa data.",
   "old": 31.6,
   "start": 37.364
  },
  {
   "id": "b07",
   "text": "Ela entende na hora: esse convite serviria pra qualquer uma.",
   "old": 35.4,
   "start": 41.766
  },
  {
   "id": "b08",
   "text": "Agora vem a virada.",
   "old": 39.2,
   "start": 46.023
  },
  {
   "id": "b08",
   "text": "Não é que ela não sai com ninguém.",
   "old": 40.4,
   "start": 47.313
  },
  {
   "id": "b08",
   "text": "Ela sai com quem chega com o convite pronto: dia, lugar, e um motivo que tem a ver com ela.",
   "old": 42.2,
   "start": 49.253
  },
  {
   "id": "b09",
   "text": "Você falou que ama café coado.",
   "old": 47.0,
   "start": 54.545
  },
  {
   "id": "b09",
   "text": "Tem um lugar perto do seu trampo que é absurdo.",
   "old": 48.6,
   "start": 56.525
  },
  {
   "id": "b09",
   "text": "Quinta, sete da noite?",
   "old": 50.8,
   "start": 59.005
  },
  {
   "id": "b09",
   "text": "E se não der, me fala um dia bom pra você.",
   "old": 52.2,
   "start": 60.095
  },
  {
   "id": "b10",
   "text": "Um convite assim vale mais que cem bora marcar.",
   "old": 55.0,
   "start": 63.071
  },
  {
   "id": "b11",
   "text": "Se ela topa, ou sugere outro dia: tem interesse.",
   "old": 57.8,
   "start": 66.328
  },
  {
   "id": "b11",
   "text": "Se ela foge de um convite concreto e não propõe nada: essa é a resposta.",
   "old": 60.4,
   "start": 69.308
  },
  {
   "id": "b11",
   "text": "Você não insiste, e nem some com raiva.",
   "old": 64.0,
   "start": 72.918
  },
  {
   "id": "b12",
   "text": "E o principal: o convite é só a porta.",
   "old": 67.2,
   "start": 76.211
  },
  {
   "id": "b12",
   "text": "Quem segura o encontro é a sua vida:",
   "old": 69.2,
   "start": 78.421
  },
  {
   "id": "b12",
   "text": "os lugares que você conhece, o que você gosta de fazer, a conversa que você tem.",
   "old": 70.8,
   "start": 80.441
  },
  {
   "id": "b13",
   "text": "Constrói isso, e chamar pra sair vira detalhe.",
   "old": 75.2,
   "start": 85.338
  },
  {
   "id": "b13",
   "text": "Tenha uma vida que dá vontade de fazer parte, e convida ela pra um pedaço dela.",
   "old": 77.6,
   "start": 88.278
  },
  {
   "id": "b14",
   "text": "Manda a sua pergunta nos comentários, que eu respondo no próximo vídeo.",
   "old": 82.0,
   "start": 93.069
  }
 ],
