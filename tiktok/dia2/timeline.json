 "phrases": [
  {
   "id": "b01",
   "text": "Ela recebe esse tipo de mensagem o dia todo.",
   "old": 0.8,
   "start": 0.6
  },
  {
   "id": "b01",
   "text": "Por que ela responderia a sua?",
   "old": 2.6,
   "start": 3.05
  },
  {
   "id": "b02",
   "text": "Elogio solto não abre conversa.",
   "old": 5.2,
   "start": 5.701
  },
  {
   "id": "b02",
   "text": "Ela não tem nada pra responder, além de obrigada.",
   "old": 8.8,
   "start": 7.751
  },
  {
   "id": "b02",
   "text": "Ou nada.",
   "old": 11.0,
   "start": 10.501
  },
  {
   "id": "b03",
   "text": "Mesmo story, outra mensagem.",
   "old": 14.2,
   "start": 12.101
  },
  {
   "id": "b03b",
   "text": "Agora ela tem o que contar.",
   "old": 19.6,
   "start": 16.445
  },
  {
   "id": "b03b",
   "text": "Você não elogiou a aparência dela: você reparou no que ela fez.",
