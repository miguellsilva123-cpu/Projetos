 "phrases": [
  {
   "id": "b00",
   "text": "Dia dois.",
   "old": -4.0,
   "start": 0.6
  },
  {
   "id": "b00b",
   "text": "Ontem eu te pedi pra anotar um detalhe de três stories.",
   "old": -3.4,
   "start": 1.788
  },
  {
   "id": "b00b",
   "text": "Hoje eu te mostro o que escrever com eles.",
   "old": -1.6,
   "start": 5.078
  },
  {
   "id": "b01",
   "text": "Ela recebe esse tipo de mensagem o dia todo.",
   "old": 0.8,
   "start": 7.732
  },
  {
   "id": "b01",
   "text": "Por que ela responderia a sua?",
   "old": 2.6,
   "start": 10.182
  },
  {
   "id": "b02",
   "text": "Elogio solto não abre conversa.",
   "old": 5.2,
   "start": 12.833
  },
  {
   "id": "b02",
   "text": "Ela não tem nada pra responder, além de obrigada.",
   "old": 8.8,
   "start": 14.883
  },
  {
   "id": "b02",
   "text": "Ou nada.",
   "old": 11.0,
   "start": 17.633
  },
  {
   "id": "b03",
   "text": "Mesmo story, outra mensagem.",
   "old": 14.2,
   "start": 19.233
  },
  {
   "id": "b03b",
   "text": "Agora ela tem o que contar.",
   "old": 19.6,
   "start": 23.577
  },
  {
   "id": "b03b",
   "text": "Você não elogiou a aparência dela: você reparou no que ela fez.",
   "old": 22.0,
   "start": 25.267
  },
  {
   "id": "b04",
   "text": "A fórmula é um detalhe do que ela mostrou,",
   "old": 25.6,
   "start": 29.28
  },
  {
   "id": "b04",
   "text": "mais uma pergunta leve, que dá vontade de responder.",
   "old": 28.0,
   "start": 31.73
  },
  {
   "id": "b04",
   "text": "Uma pergunta que não se responde com sim ou não.",
   "old": 31.0,
   "start": 34.39
  },
  {
   "id": "b05",
   "text": "Ao vivo funciona igual:",
   "old": 34.4,
   "start": 37.337
  },
  {
   "id": "b05",
   "text": "você entendeu alguma coisa dessa aula, ou fui só eu?",
   "old": 35.8,
   "start": 38.877
  },
  {
   "id": "b06",
   "text": "Missão de hoje: pega um daqueles três detalhes e escreve a sua abertura.",
   "old": 39.0,
   "start": 42.157
  },
  {
   "id": "b06",
   "text": "Amanhã: como não deixar a conversa morrer depois que ela responde.",
   "old": 42.5,
   "start": 46.027
  }
 ],
