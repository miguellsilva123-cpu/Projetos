 "phrases": [
  {
   "id": "b00",
   "text": "Dia três.",
   "old": -4.0,
   "start": 0.6
  },
  {
   "id": "b00b",
   "text": "Ela respondeu a sua abertura.",
   "old": -3.2,
   "start": 1.74
  },
  {
   "id": "b00b",
   "text": "E agora?",
   "old": -1.4,
   "start": 3.36
  },
  {
   "id": "b01",
   "text": "Se a sua conversa parece isso...",
   "old": 0.6,
   "start": 4.446
  },
  {
   "id": "b01",
   "text": "ela não tá te conhecendo.",
   "old": 3.0,
   "start": 6.296
  },
  {
   "id": "b01",
   "text": "Ela tá preenchendo um formulário.",
   "old": 4.3,
   "start": 7.786
  },
  {
   "id": "b02",
   "text": "O erro é pular de assunto.",
   "old": 6.5,
   "start": 10.24
  },
  {
   "id": "b02",
   "text": "Cada pergunta nova joga fora a resposta anterior.",
   "old": 8.0,
   "start": 11.72
  },
  {
   "id": "b02",
   "text": "A conversa fica sem fio... e morre.",
   "old": 11.0,
   "start": 14.34
  },
  {
   "id": "b03",
   "text": "Toda resposta dela tem um detalhe.",
   "old": 13.6,
   "start": 17.356
  },
  {
   "id": "b03",
   "text": "Pega esse detalhe e vai mais fundo.",
   "old": 15.5,
   "start": 19.466
  },
  {
   "id": "b04",
   "text": "Ela disse que trabalha o dia todo e faz faculdade à noite?",
   "old": 17.5,
   "start": 21.675
  },
  {
   "id": "b04",
   "text": "Pergunta: que horas você dorme?",
   "old": 20.0,
   "start": 24.925
  },
  {
   "id": "b05",
   "text": "E não fica só perguntando.",
   "old": 25.2,
   "start": 29.37
  },
  {
   "id": "b05",
   "text": "Comenta o que ela disse,",
   "old": 26.5,
   "start": 30.95
  },
  {
   "id": "b05",
   "text": "conta algo seu,",
   "old": 28.0,
   "start": 32.07
  },
  {
   "id": "b05",
   "text": "e devolve a bola.",
   "old": 29.5,
   "start": 32.87
  },
  {
   "id": "b05",
   "text": "É pingue-pongue, não interrogatório.",
   "old": 31.0,
   "start": 34.01
  },
  {
   "id": "b06",
   "text": "No encontro é igual.",
   "old": 33.3,
   "start": 36.412
  },
  {
   "id": "b06",
   "text": "Ela foi num show no fim de semana?",
   "old": 34.6,
   "start": 37.582
  },
  {
   "id": "b06",
   "text": "Não pergunta: foi bom?",
   "old": 36.2,
   "start": 39.252
  },
  {
