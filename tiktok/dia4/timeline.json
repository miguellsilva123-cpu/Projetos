 "phrases": [
  {
   "id": "b00",
   "text": "Dia quatro.",
   "old": -1.2,
   "start": 0.6
  },
  {
   "id": "b01",
   "text": "Ela tava respondendo bem.",
   "old": 0.2,
   "start": 1.793
  },
  {
   "id": "b01",
   "text": "Do nada: resposta curta, demora, e sumiu.",
   "old": 1.6,
   "start": 3.443
  },
  {
   "id": "b02",
   "text": "Quase sempre foi um dos cinco vacilos que eu te prometi ontem.",
   "old": 4.4,
   "start": 6.186
  },
  {
   "id": "b03",
   "text": "Um: puxar pro lado sexual antes de ela te conhecer.",
   "old": 7.0,
   "start": 10.175
  },
  {
   "id": "b03",
   "text": "Ela entende que você só quer uma coisa.",
   "old": 10.2,
   "start": 13.225
  },
  {
   "id": "b04",
   "text": "Dois: cobrar resposta.",
   "old": 13.5,
   "start": 16.145
  },
  {
   "id": "b04",
   "text": "Aquele sumiu? transforma interesse em obrigação.",
   "old": 15.6,
   "start": 17.305
  },
  {
   "id": "b05",
   "text": "Três: mandar mensagem atrás de mensagem sem ela responder.",
   "old": 20.5,
   "start": 20.959
  },
  {
   "id": "b05",
   "text": "A ansiedade aparece no texto.",
   "old": 24.0,
   "start": 24.849
  },
  {
   "id": "b06",
   "text": "Quatro: falar só de você.",
   "old": 27.5,
   "start": 27.299
  },
  {
   "id": "b06",
   "text": "Se ela sai do encontro e você não sabe nada dela,",
   "old": 29.2,
   "start": 29.029
  },
  {
   "id": "b06",
   "text": "foi um monólogo, não um encontro.",
   "old": 31.8,
   "start": 31.589
  },
  {
   "id": "b07",
   "text": "Cinco: olhar o celular enquanto ela fala.",
   "old": 34.5,
   "start": 33.917
  },
  {
   "id": "b07",
   "text": "Ela percebe na hora que não é prioridade.",
   "old": 37.2,
   "start": 36.317
  },
  {
   "id": "b08",
   "text": "Se você se viu em algum, tudo bem.",
   "old": 41.0,
   "start": 39.337
  },
  {
   "id": "b08",
   "text": "Todo mundo já fez.",
   "old": 42.4,
   "start": 41.297
  },
  {
   "id": "b08",
   "text": "O que importa é parar agora.",
   "old": 43.4,
   "start": 42.417
  },
  {
   "id": "b09",
   "text": "Missão de hoje: relê a última conversa que morreu e marca qual vacilo apareceu.",
   "old": 45.0,
   "start": 44.289
  },
  {
   "id": "b09",
   "text": "Amanhã, último dia: o que fazer quando bate o silêncio.",
