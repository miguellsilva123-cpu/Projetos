 "phrases": [
  {
   "id": "b01",
   "text": "Acabou o assunto no encontro?",
   "old": 0.3,
   "start": 0.5
  },
  {
   "id": "b01",
   "text": "Tem uma frase que salva.",
   "old": 1.9,
   "start": 2.22
  },
  {
   "id": "b02",
   "text": "Primeiro: calma.",
   "old": 4.3,
   "start": 4.213
  },
  {
   "id": "b02",
   "text": "Alguns segundos de silêncio são normais.",
   "old": 5.8,
   "start": 5.233
  },
  {
   "id": "b02",
   "text": "O que mata é o desespero de disparar qualquer pergunta.",
   "old": 8.6,
   "start": 7.673
  },
  {
   "id": "b03",
   "text": "Segundo: volta num assunto que ficou aberto.",
   "old": 13.3,
   "start": 11.0
  },
  {
   "id": "b03",
   "text": "A frase é essa:",
   "old": 16.3,
   "start": 13.37
  },
  {
   "id": "b03",
   "text": "Peraí, você não terminou de contar daquele show.",
   "old": 17.0,
   "start": 14.42
  },
  {
   "id": "b03",
   "text": "Ela percebe que você prestou atenção,",
   "old": 20.5,
   "start": 17.08
  },
  {
   "id": "b03",
   "text": "e a conversa volta sozinha.",
   "old": 22.8,
   "start": 19.19
  },
  {
   "id": "b04",
   "text": "Terceiro: sem assunto aberto, usa o que tá na sua frente.",
   "old": 25.3,
   "start": 21.221
  },
  {
   "id": "b04",
   "text": "O lugar, a música, o que vocês pediram.",
   "old": 28.6,
   "start": 24.391
  },
  {
   "id": "b05",
   "text": "E no direct, quando a conversa tá boa, não deixa esfriar.",
   "old": 32.4,
   "start": 27.111
  },
  {
   "id": "b05",
   "text": "Chama pra algo concreto:",
   "old": 35.4,
   "start": 30.211
  },
  {
   "id": "b05",
   "text": "Você falou que queria um hambúrguer bom. Conheço um... Sábado?",
   "old": 36.8,
   "start": 31.231
  },
  {
   "id": "b06",
   "text": "Chamar, abrir, sustentar, não vacilar e lidar com o silêncio.",
   "old": 41.3,
   "start": 35.13
  },
  {
   "id": "b06",
   "text": "Esses foram os cinco dias.",
   "old": 44.3,
   "start": 38.831
  },
  {
   "id": "b07",
   "text": "Isso é só uma parte do protocolo.",
   "old": 46.3,
   "start": 40.731
  },
  {
   "id": "b07",
   "text": "O completo vai do primeiro direct ao primeiro encontro, em onze capítulos.",
   "old": 47.5,
   "start": 42.661
  },
  {
   "id": "b07",
   "text": "Comenta presença, que eu te mando o acesso.",
   "old": 49.6,
   "start": 46.891
  }
 ],
